{
  "name": "@tianacloud/dsh-tiana",
  "version": "0.11.5",
  "type": "module",
  "description": "DeepSeek Harness 的 Tiana 插件：浏览应用模板、本地开发预览、管理站点与空间。",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tianacloud/dsh-tiana"
  },
  "author": {
    "name": "Tiana Cloud",
    "url": "https://github.com/tianacloud"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tiana",
    "tianacloud",
    "web-app",
    "templates"
  ],
  "main": "./host-main.js",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "test:ui": "node --test test/ui/*.test.mjs"
  },
  "exports": {
    ".": "./host-main.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "host-main.js",
    "install.js",
    "tiana-api.js",
    "preview-bind.js",
    "dev-preview.js",
    "confined-run.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/bootstrap.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^7.3.7"
  }
}
